{
  "name": "kbparus-metal-storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "npm run images:optimize",
    "dev": "next dev",
    "images:optimize": "npm run images:optimize-catalog && npm run images:optimize-products",
    "images:optimize-catalog": "node scripts/media/optimize-catalog-images.mjs",
    "images:optimize-products": "node scripts/media/optimize-product-images.mjs",
    "prebuild": "npm run images:optimize",
    "build": "next build",
    "vercel-build": "npm run images:optimize && node scripts/cms/check.mjs && node scripts/cms/safe-generate-importmap.mjs && node scripts/cms/check.mjs && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && node e2e/run.mjs",
    "test:e2e:update": "npm run build && node e2e/run.mjs visual.spec.ts --update-snapshots",
    "test:e2e:report": "playwright show-report output/playwright/report",
    "cms:check": "node scripts/cms/check.mjs",
    "cms:generate-importmap": "node scripts/cms/safe-generate-importmap.mjs",
    "cms:migrate:audit": "node scripts/cms/audit-migration-state.mjs",
    "cms:migrate:create": "node scripts/cms/run-payload-migration.mjs migrate:create",
    "cms:migrate:status": "node scripts/cms/run-payload-migration.mjs migrate:status",
    "cms:migrate:apply": "node scripts/cms/run-payload-migration.mjs migrate",
    "cms:validate-deployment": "node scripts/cms/validate-deployment.mjs",
    "smoke:deployment": "node scripts/cms/validate-deployment.mjs",
    "smoke:production": "node scripts/cms/validate-deployment.mjs https://kbparus-metal-storage.vercel.app --production",
    "cms:admin-smoke": "node scripts/cms/admin-smoke.mjs",
    "cms:seed-catalog": "tsx scripts/cms/seed-catalog-remote.ts",
    "cms:seed-home-content": "tsx scripts/cms/seed-home-content-remote.ts",
    "cms:seed-media": "tsx scripts/cms/seed-media-remote.ts",
    "cms:seed-site-navigation": "tsx scripts/cms/seed-site-navigation-remote.ts",
    "cms:seed-catalog:local": "tsx scripts/cms/seed-catalog.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/drizzle": "3.86.0",
    "@payloadcms/email-nodemailer": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-vercel-blob": "3.86.0",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "nodemailer": "^9.0.3",
    "payload": "3.86.0",
    "pg": "8.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "24.9.2",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "dompurify": "3.4.12",
    "postcss": "8.5.23",
    "sharp": "$sharp"
  }
}
