# ===========================================================
# Переменные окружения для сайта КБ Парус
# Скопируйте этот файл в .env.local и заполните значения
# ===========================================================

# --- Runtime and CMS security ---
# Public origin used in canonical links and same-origin lead checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pooled URL is used by the website at runtime.
DATABASE_URL=

# Direct URL is used only by explicitly started migration/audit commands.
# It is never used as a fallback for the production runtime.
DATABASE_URL_UNPOOLED=

# Required for Payload media stored in Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# Required in Vercel Production: use a unique random value of at least 32 characters.
# Never commit the real production secret.
PAYLOAD_SECRET=

# --- Lead endpoint security and rate limiting ---
# Optional comma-separated additional browser origins.
# LEAD_ALLOWED_ORIGINS=https://kbparus.ru,https://www.kbparus.ru
LEAD_ALLOWED_ORIGINS=

# Keep false in production. Enable only for a trusted non-browser integration
# that cannot send an Origin header.
LEAD_ALLOW_NO_ORIGIN=false

# Per-client request limit and window (milliseconds).
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_MS=60000

# Optional hashing salt. If empty, PAYLOAD_SECRET is used.
LEAD_RATE_LIMIT_SALT=

# Recommended for a distributed rate limit across Vercel instances.
# If empty, the API safely falls back to a bounded in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Telegram-бот для уведомлений менеджеров (РЕКОМЕНДУЕТСЯ) ---
# Получить токен у @BotFather → /newbot → следуйте инструкциям
# TELEGRAM_BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=

# ID группы или личного чата, куда бот будет писать заявки
# Группа: создайте группу, добавьте бота как администратора, отправьте /start
# Чтобы узнать chat_id: добавьте @userinfobot или @getidsbot в группу
# Для группы chat_id обычно отрицательный (например, -1001234567890)
# TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_CHAT_ID=

# --- Email delivery for leads (primary external channel) ---
# Заявки отправляются на LEAD_EMAIL_TO через SMTP. Это основной канал, если Bitrix24 создает лиды из входящей почты.
LEAD_EMAIL_TO=info@kbparus.ru
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional sender name used by lead emails and Payload system messages.
SMTP_FROM_NAME=КБ Парус

# --- Bitrix24 webhook (опционально) ---
# Создаётся в Bitrix24: Приложения → Webhooks → Входящий webhook
# Разрешите права crm.deal.add, crm.lead.add
# Формат: https://YOUR.bitrix24.ru/rest/USER_ID/TOKEN/crm.deal.add.json
# Если указан базовый https://YOUR.bitrix24.ru/rest/USER_ID/TOKEN/, код добавит crm.deal.add.json автоматически.
# Доставка в Bitrix24 выполняется только при BITRIX24_ENABLED=true.
BITRIX24_ENABLED=false
BITRIX24_WEBHOOK_URL=

# --- Bitrix24 custom fields (optional) ---
# Create these fields in CRM deal/lead card and paste exact field codes here.
# If a code is empty, the value still goes into COMMENTS as a safe fallback.
BITRIX24_FIELD_CITY=
BITRIX24_FIELD_FORM_TYPE=
BITRIX24_FIELD_SOURCE_PAGE=
BITRIX24_FIELD_SOURCE_TITLE=
BITRIX24_FIELD_UTM=
BITRIX24_FIELD_CALCULATOR_CONFIG=
BITRIX24_FIELD_SELECTED_PRODUCT=
BITRIX24_FIELD_PRELIMINARY_PRICE_FROM=

# --- Yandex Metrika (optional) ---
# Public counter id. If empty, script and goals are skipped safely.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# --- Search verification (optional) ---
# Verification tokens only, without the surrounding HTML meta tags.
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# --- SEO reports: Google Search Console ---
# Service account must have read access to the exact Search Console property.
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
# Keep the PEM key secret. Vercel may store line breaks as escaped \n.
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
# Exact property id, for example sc-domain:example.ru or https://example.ru/.
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# --- SEO reports: Yandex Webmaster ---
YANDEX_WEBMASTER_OAUTH_TOKEN=
YANDEX_WEBMASTER_USER_ID=
YANDEX_WEBMASTER_HOST_ID=
# Optional comma-separated region IDs.
YANDEX_WEBMASTER_REGION_IDS=

# Приоритет каналов:
# 1. Если настроены SMTP_* — заявки уходят на email (основной внешний канал)
# 2. Если установлены TELEGRAM_* — параллельно уходят уведомления в Telegram
# 3. Если установлены BITRIX24_WEBHOOK_URL и BITRIX24_ENABLED=true — параллельно включается webhook CRM
# 4. Если внешние каналы выключены — заявка сохраняется в CMS при доступной базе.
#    Если ни один реальный канал не сработал, API возвращает 503 без ложного успеха.
